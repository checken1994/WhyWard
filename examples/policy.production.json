{
  "policy": {
    "schema_version": 2,
    "profile": "production",
    "allowed_tools": [
      "read_text",
      "write_text"
    ],
    "protected_path_prefixes": [
      ".whyward",
      "control",
      "keys",
      "policy",
      "policies",
      ".git"
    ],
    "allowed_source_ids": [
      "internal-test",
      "usgs"
    ],
